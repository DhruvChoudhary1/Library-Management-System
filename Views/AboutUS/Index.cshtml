@{
    ViewData["Title"] = "About Us";
}

<div class="container py-4">

    <div class="bg-white rounded shadow-sm p-4 p-md-5">

        <h2 class="mb-4 fw-bold text-dark">
            About Us
        </h2>

        <p class="text-muted lead">
            Welcome to Library Management, your portal for digital
            and physical resource tracking.
        </p>

        <p class="text-secondary">
            Our mission is to simplify library management by providing
            a seamless, fast, and secure system for students, librarians,
            and administrators.
        </p>

        <p class="text-secondary">
            The system allows users to manage books, check availability,
            maintain borrowing records, manage students and librarians,
            and organize other library resources efficiently.
        </p>

        <div class="row mt-5">

            <div class="col-md-4 mb-4">
                <h5 class="fw-bold">
                    Our Vision
                </h5>

                <p class="text-muted">
                    To build a connected library environment where
                    academic resources are easy to manage and accessible
                    to users efficiently.
                </p>
            </div>

            <div class="col-md-4 mb-4">
                <h5 class="fw-bold">
                    Smart Tracking
                </h5>

                <p class="text-muted">
                    Track book availability, borrowing activity,
                    return information, students, librarians,
                    magazines, and newspapers.
                </p>
            </div>

            <div class="col-md-4 mb-4">
                <h5 class="fw-bold">
                    Easy Access
                </h5>

                <p class="text-muted">
                    A simple and responsive interface designed for
                    efficient library management across different devices.
                </p>
            </div>

        </div>

    </div>

</div>