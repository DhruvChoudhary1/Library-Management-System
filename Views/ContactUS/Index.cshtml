@{
    ViewData["Title"] = "Contact Us";
}

<div class="container py-4">

    <div class="text-center mb-5">
        <h2 class="fw-bold">Contact Us</h2>

        <p class="text-muted">
            Have questions or need assistance? Get in touch with us.
        </p>
    </div>

    <div class="row g-4">

        <!-- Contact Information -->
        <div class="col-md-5">

            <div class="card shadow-sm h-100">

                <div class="card-body p-4">

                    <h4 class="mb-4">
                        Contact Information
                    </h4>

                    <div class="mb-4">
                        <h6 class="fw-bold">📍 Address</h6>

                        <p class="text-muted mb-0">
                            Library Management System<br />
                            University Campus<br />
                            India
                        </p>
                    </div>

                    <div class="mb-4">
                        <h6 class="fw-bold">📧 Email</h6>

                        <p class="text-muted mb-0">
                            library@example.com
                        </p>
                    </div>

                    <div>
                        <h6 class="fw-bold">📞 Phone</h6>

                        <p class="text-muted mb-0">
                            +91 98765 43210
                        </p>
                    </div>

                </div>

            </div>

        </div>

        <!-- Contact Form -->
        <div class="col-md-7">

            <div class="card shadow-sm">

                <div class="card-body p-4">

                    <h4 class="mb-4">
                        Send a Message
                    </h4>

                    <form>

                        <div class="mb-3">

                            <label class="form-label">
                                Name
                            </label>

                            <input type="text"
                                   class="form-control"
                                   placeholder="Enter your name"
                                   required />

                        </div>

                        <div class="mb-3">

                            <label class="form-label">
                                Email
                            </label>

                            <input type="email"
                                   class="form-control"
                                   placeholder="Enter your email"
                                   required />

                        </div>

                        <div class="mb-3">

                            <label class="form-label">
                                Subject
                            </label>

                            <input type="text"
                                   class="form-control"
                                   placeholder="Enter subject"
                                   required />

                        </div>

                        <div class="mb-3">

                            <label class="form-label">
                                Message
                            </label>

                            <textarea class="form-control"
                                      rows="5"
                                      placeholder="Enter your message"
                                      required></textarea>

                        </div>

                        <button type="submit"
                                class="btn btn-primary">
                            Send Message
                        </button>

                    </form>

                </div>

            </div>

        </div>

    </div>

</div>