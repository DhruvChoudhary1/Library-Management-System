@model LibraryManagement.Models.LibrarianIndexViewModel

@{
    ViewData["Title"] = "Librarians";
}

<!-- ============================================================= -->
<!-- HEADER -->
<!-- ============================================================= -->

<div class="d-flex justify-content-between align-items-center mb-4">

    <div>
        <h2 class="mb-1">
            👨‍💼 Librarians
        </h2>

        <p class="text-muted mb-0">
            Manage librarian records in the library system.
        </p>
    </div>

    <a asp-controller="Librarian"
       asp-action="Create"
       class="btn btn-primary">

        ➕ Add New Librarian

    </a>

</div>


<!-- ============================================================= -->
<!-- SEARCH -->
<!-- ============================================================= -->

<div class="card shadow-sm mb-4">

    <div class="card-body">

        <form asp-controller="Librarian"
              asp-action="Index"
              method="get">

            <div class="row g-2">

                <div class="col-md-9">

                    <input type="text"
                           name="searchTerm"
                           value="@Model.SearchTerm"
                           class="form-control"
                           placeholder="Search by name or phone..." />

                </div>

                <div class="col-md-3">

                    <div class="d-grid gap-2 d-md-flex">

                        <button type="submit"
                                class="btn btn-primary flex-fill">

                            🔍 Search

                        </button>

                        @if (!string.IsNullOrWhiteSpace(Model.SearchTerm))
                        {
                            <a asp-controller="Librarian"
                               asp-action="Index"
                               class="btn btn-secondary flex-fill">

                                Clear

                            </a>
                        }

                    </div>

                </div>

            </div>

        </form>

    </div>

</div>


<!-- ============================================================= -->
<!-- LIBRARIAN TABLE -->
<!-- ============================================================= -->

<div class="card shadow-sm">

    <div class="card-body">

        @if (Model.Librarians != null && Model.Librarians.Any())
        {
            <div class="table-responsive">

                <table class="table table-striped table-hover align-middle">

                    <thead class="table-dark">

                        <tr>

                            <th>
                                ID
                            </th>

                            <th>
                                Name
                            </th>

                            <th>
                                Age
                            </th>

                            <th>
                                Phone
                            </th>

                            <th class="text-center">
                                Actions
                            </th>

                        </tr>

                    </thead>


                    <tbody>

                        @foreach (var item in Model.Librarians)
                        {
                            <tr>

                                <!-- ID -->

                                <td>
                                    @item.LibrarianId
                                </td>


                                <!-- NAME -->

                                <td>

                                    <strong>
                                        @item.Name
                                    </strong>

                                </td>


                                <!-- AGE -->

                                <td>
                                    @item.Age
                                </td>


                                <!-- PHONE -->

                                <td>
                                    @item.Phone
                                </td>


                                <!-- ACTIONS -->

                                <td class="text-center">

                                    <div class="d-flex flex-wrap gap-1 justify-content-center">

                                        <!-- EDIT -->

                                        <a asp-controller="Librarian"
                                           asp-action="Edit"
                                           asp-route-id="@item.LibrarianId"
                                           class="btn btn-sm btn-warning">

                                            Edit

                                        </a>


                                        <!-- DELETE -->

                                        <a asp-controller="Librarian"
                                           asp-action="Delete"
                                           asp-route-id="@item.LibrarianId"
                                           class="btn btn-sm btn-danger">

                                            Delete

                                        </a>

                                    </div>

                                </td>

                            </tr>
                        }

                    </tbody>

                </table>

            </div>
        }
        else
        {
            <!-- ================================================= -->
            <!-- NO LIBRARIANS -->
            <!-- ================================================= -->

            <div class="text-center py-5">

                <h4>
                    No librarians found
                </h4>

                @if (!string.IsNullOrWhiteSpace(Model.SearchTerm))
                {
                    <p class="text-muted">

                        No librarians matched
                        "<strong>@Model.SearchTerm</strong>".

                    </p>

                    <a asp-controller="Librarian"
                       asp-action="Index"
                       class="btn btn-secondary">

                        Show All Librarians

                    </a>
                }
                else
                {
                    <p class="text-muted">
                        There are currently no librarian records.
                    </p>

                    <a asp-controller="Librarian"
                       asp-action="Create"
                       class="btn btn-primary">

                        ➕ Add First Librarian

                    </a>
                }

            </div>
        }

    </div>

</div>


<!-- ============================================================= -->
<!-- PAGINATION -->
<!-- ============================================================= -->

@if (Model.TotalPages > 1)
{
    <nav class="mt-4"
         aria-label="Librarian pagination">

        <ul class="pagination justify-content-center">

            <!-- PREVIOUS -->

            <li class="page-item @(Model.CurrentPage <= 1 ? "disabled" : "")">

                <a class="page-link"
                   asp-controller="Librarian"
                   asp-action="Index"
                   asp-route-page="@(Model.CurrentPage - 1)"
                   asp-route-searchTerm="@Model.SearchTerm">

                    Previous

                </a>

            </li>


            <!-- PAGE NUMBERS -->

            @for (int i = 1; i <= Model.TotalPages; i++)
            {
                <li class="page-item @(Model.CurrentPage == i ? "active" : "")">

                    <a class="page-link"
                       asp-controller="Librarian"
                       asp-action="Index"
                       asp-route-page="@i"
                       asp-route-searchTerm="@Model.SearchTerm">

                        @i

                    </a>

                </li>
            }


            <!-- NEXT -->

            <li class="page-item @(Model.CurrentPage >= Model.TotalPages ? "disabled" : "")">

                <a class="page-link"
                   asp-controller="Librarian"
                   asp-action="Index"
                   asp-route-page="@(Model.CurrentPage + 1)"
                   asp-route-searchTerm="@Model.SearchTerm">

                    Next

                </a>

            </li>

        </ul>

    </nav>
}


<!-- ============================================================= -->
<!-- PAGE INFORMATION -->
<!-- ============================================================= -->

@if (Model.TotalPages > 0)
{
    <div class="text-center text-muted mt-2">

        Page @Model.CurrentPage of @Model.TotalPages

    </div>
}