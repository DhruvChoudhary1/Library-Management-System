<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />

    <title>@ViewData["Title"] - Library Management</title>

    <!-- Bootstrap CSS -->
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css"
          rel="stylesheet">

    <!-- Custom CSS -->
    <link rel="stylesheet"
          href="~/css/site.css"
          asp-append-version="true" />
</head>

<body>

    <!-- ========================================================= -->
    <!-- NAVBAR -->
    <!-- ========================================================= -->

    <nav class="navbar navbar-expand-lg navbar-dark bg-dark">

        <div class="container-fluid px-4">

            <!-- Brand -->
            <a class="navbar-brand"
               asp-controller="Home"
               asp-action="Index">
                📚 Library Management
            </a>

            <!-- Mobile Toggle -->
            <button class="navbar-toggler"
                    type="button"
                    data-bs-toggle="collapse"
                    data-bs-target="#navbarNav"
                    aria-controls="navbarNav"
                    aria-expanded="false"
                    aria-label="Toggle navigation">

                <span class="navbar-toggler-icon"></span>

            </button>

            <div class="collapse navbar-collapse"
                 id="navbarNav">

                <!-- ================================================= -->
                <!-- LEFT NAVIGATION -->
                <!-- ================================================= -->

                <ul class="navbar-nav me-auto">

                    <!-- HOME - PUBLIC -->
                    <li class="nav-item">

                        <a class="nav-link"
                           asp-controller="Home"
                           asp-action="Index">

                            Home

                        </a>

                    </li>


                    <!-- ================================================= -->
                    <!-- AUTHENTICATED USER LINKS -->
                    <!-- ================================================= -->

                    @if (User.Identity?.IsAuthenticated == true)
                    {
                        <!-- BOOKS -->

                        <li class="nav-item">

                            <a class="nav-link"
                               asp-controller="Books"
                               asp-action="Index">

                                Books

                            </a>

                        </li>


                        <!-- MAGAZINES -->

                        <li class="nav-item">

                            <a class="nav-link"
                               asp-controller="Magazine"
                               asp-action="Index">

                                Magazines

                            </a>

                        </li>


                        <!-- NEWSPAPERS -->

                        <li class="nav-item">

                            <a class="nav-link"
                               asp-controller="Newspaper"
                               asp-action="Index">

                                Newspapers

                            </a>

                        </li>
                    }


                    <!-- ================================================= -->
                    <!-- ADMIN + LIBRARIAN -->
                    <!-- ================================================= -->

                    @if (User.IsInRole("Admin") ||
                         User.IsInRole("Librarian"))
                    {
                        <!-- DASHBOARD -->

                        <li class="nav-item">

                            <a class="nav-link"
                               asp-controller="Dashboard"
                               asp-action="Index">

                                Dashboard

                            </a>

                        </li>


                        <!-- BORROW HISTORY -->

                        <li class="nav-item">

                            <a class="nav-link"
                               asp-controller="Borrow"
                               asp-action="History">

                                Borrow History

                            </a>

                        </li>


                        <!-- STUDENTS -->

                        <li class="nav-item">

                            <a class="nav-link"
                               asp-controller="Student"
                               asp-action="Index">

                                Students

                            </a>

                        </li>
                    }


                    <!-- ================================================= -->
                    <!-- ADMIN ONLY -->
                    <!-- ================================================= -->

                    @if (User.IsInRole("Admin"))
                    {
                        <!-- LIBRARIANS -->

                        <li class="nav-item">

                            <a class="nav-link"
                               asp-controller="Librarian"
                               asp-action="Index">

                                Librarians

                            </a>

                        </li>


                        <!-- CREATE LIBRARIAN -->

                        <li class="nav-item">

                            <a class="nav-link"
                               asp-controller="Admin"
                               asp-action="CreateLibrarian">

                                Create Librarian

                            </a>

                        </li>
                    }


                    <!-- ================================================= -->
                    <!-- PUBLIC LINKS -->
                    <!-- ================================================= -->

                    <li class="nav-item">

                        <a class="nav-link"
                           asp-controller="AboutUS"
                           asp-action="Index">

                            About Us

                        </a>

                    </li>


                    <li class="nav-item">

                        <a class="nav-link"
                           asp-controller="ContactUS"
                           asp-action="Index">

                            Contact Us

                        </a>

                    </li>

                </ul>


                <!-- ================================================= -->
                <!-- RIGHT NAVIGATION -->
                <!-- ================================================= -->

                <ul class="navbar-nav align-items-lg-center">

                    @if (User.Identity?.IsAuthenticated == true)
                    {
                        <!-- ========================================= -->
                        <!-- ADD BOOK -->
                        <!-- ADMIN + LIBRARIAN -->
                        <!-- ========================================= -->

                        @if (User.IsInRole("Admin") ||
                             User.IsInRole("Librarian"))
                        {
                            <li class="nav-item">

                                <a class="nav-link"
                                   asp-controller="Books"
                                   asp-action="Create">

                                    ➕ Add Book

                                </a>

                            </li>
                        }


                        <!-- ========================================= -->
                        <!-- CURRENT USER -->
                        <!-- ========================================= -->

                        <li class="nav-item">

                            <span class="nav-link text-light">

                                👤 @User.Identity.Name

                                @if (User.IsInRole("Admin"))
                                {
                                    <span class="badge bg-danger ms-1">
                                        Admin
                                    </span>
                                }
                                else if (User.IsInRole("Librarian"))
                                {
                                    <span class="badge bg-primary ms-1">
                                        Librarian
                                    </span>
                                }
                                else
                                {
                                    <span class="badge bg-secondary ms-1">
                                        User
                                    </span>
                                }

                            </span>

                        </li>


                        <!-- ========================================= -->
                        <!-- LOGOUT -->
                        <!-- ========================================= -->

                        <li class="nav-item">

                            <form asp-controller="Account"
                                  asp-action="Logout"
                                  method="post"
                                  class="d-inline">

                                <button type="submit"
                                        class="nav-link btn btn-link text-danger border-0">

                                    Logout

                                </button>

                            </form>

                        </li>
                    }
                    else
                    {
                        <!-- ========================================= -->
                        <!-- LOGIN -->
                        <!-- ========================================= -->

                        <li class="nav-item">

                            <a class="nav-link"
                               asp-controller="Account"
                               asp-action="Login">

                                Login

                            </a>

                        </li>


                        <!-- ========================================= -->
                        <!-- REGISTER -->
                        <!-- ========================================= -->

                        <li class="nav-item">

                            <a class="nav-link"
                               asp-controller="Account"
                               asp-action="Register">

                                Register

                            </a>

                        </li>
                    }

                </ul>

            </div>

        </div>

    </nav>


    <!-- ========================================================= -->
    <!-- MAIN CONTENT -->
    <!-- ========================================================= -->

    <main class="container mt-4">

        <!-- ===================================================== -->
        <!-- SUCCESS MESSAGE -->
        <!-- ===================================================== -->

        @if (TempData["Success"] != null)
        {
            <div class="alert alert-success alert-dismissible fade show"
                 role="alert">

                @TempData["Success"]

                <button type="button"
                        class="btn-close"
                        data-bs-dismiss="alert"
                        aria-label="Close">
                </button>

            </div>
        }


        <!-- ===================================================== -->
        <!-- ERROR MESSAGE -->
        <!-- ===================================================== -->

        @if (TempData["Error"] != null)
        {
            <div class="alert alert-danger alert-dismissible fade show"
                 role="alert">

                @TempData["Error"]

                <button type="button"
                        class="btn-close"
                        data-bs-dismiss="alert"
                        aria-label="Close">
                </button>

            </div>
        }


        <!-- ===================================================== -->
        <!-- PAGE CONTENT -->
        <!-- ===================================================== -->

        @RenderBody()

    </main>


    <!-- ========================================================= -->
    <!-- FOOTER -->
    <!-- ========================================================= -->

    <footer class="text-center mt-5 mb-3 text-muted">

        <hr />

        <p>
            © @DateTime.Now.Year - Library Management System
        </p>

    </footer>


    <!-- ========================================================= -->
    <!-- BOOTSTRAP JS -->
    <!-- ========================================================= -->

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js">
    </script>


    <!-- ========================================================= -->
    <!-- PAGE SPECIFIC SCRIPTS -->
    <!-- ========================================================= -->

    @await RenderSectionAsync("Scripts", required: false)

</body>

</html>